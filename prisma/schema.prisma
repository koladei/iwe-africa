generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  TELEGRAM
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ApplicationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  ciphertext String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Learner {
  id              String              @id @default(cuid())
  userId          String              @unique
  displayName     String
  ageConfirmedAt  DateTime
  timezone        String              @default("Africa/Lagos")
  reminderTime    String              @default("18:00")
  currentStreak   Int                 @default(0)
  longestStreak   Int                 @default(0)
  lastCompletedOn DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  identities      ChannelIdentity[]
  completions     LessonCompletion[]
  attempts        QuizAttempt[]
  memberships     CircleMembership[]
  invites         CircleInvite[]      @relation("InviteCreator")
  deliveries      MessageDelivery[]
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  learner       Learner?
  roleMemberships       UserRole[]            @relation("UserRoleMembership")
  grantedRoleMemberships UserRole[]            @relation("UserRoleGrantor")
  directPrivileges      UserPrivilege[]       @relation("UserPrivilegeMembership")
  grantedPrivileges     UserPrivilege[]       @relation("UserPrivilegeGrantor")
  authorizationAudits   AuthorizationAudit[]  @relation("AuthorizationAuditActor")
  lessonsCreated        Lesson[]              @relation("LessonCreatedBy")
  lessonsPublished      Lesson[]              @relation("LessonPublishedBy")
  lessonsArchived       Lesson[]              @relation("LessonArchivedBy")

  @@map("user")
}

model Privilege {
  id          String          @id @default(cuid())
  key         String          @unique
  title       String
  description String
  createdAt   DateTime        @default(now())
  roleGrants  RolePrivilege[]
  userGrants  UserPrivilege[]
}

model Role {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String          @unique
  description String
  isBuiltIn   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  privileges  RolePrivilege[]
  memberships UserRole[]
}

model RolePrivilege {
  roleId      String
  privilegeId String
  createdAt   DateTime  @default(now())
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@id([roleId, privilegeId])
}

model UserRole {
  userId      String
  roleId      String
  grantedById String?
  createdAt   DateTime @default(now())
  user        User     @relation("UserRoleMembership", fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy   User?    @relation("UserRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserPrivilege {
  userId      String
  privilegeId String
  grantedById String?
  createdAt   DateTime  @default(now())
  user        User      @relation("UserPrivilegeMembership", fields: [userId], references: [id], onDelete: Cascade)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("UserPrivilegeGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, privilegeId])
  @@index([privilegeId])
}

model AuthorizationAudit {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  targetUserId String?
  targetRoleId String?
  subject      String?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuthorizationAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([targetRoleId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                   String    @id
  accountId            String
  providerId           String
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ChannelIdentity {
  id        String   @id @default(cuid())
  learnerId String
  channel   Channel
  channelId String
  createdAt DateTime @default(now())
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([channel, channelId])
}

model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  lessons     Lesson[]
}

model Lesson {
  id          String         @id @default(cuid())
  slug        String         @unique
  topicId     String
  title       String
  conceptBite String
  sourceTitle String
  sourceUrl   String
  audioUrl    String?
  order       Int
  status      LessonStatus @default(DRAFT)
  createdById String?
  publishedById String?
  publishedAt DateTime?
  archivedById String?
  archivedAt DateTime?
  revisionOfId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  topic       Topic          @relation(fields: [topicId], references: [id])
  questions   Question[]
  completions LessonCompletion[]
  createdBy   User?          @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User?          @relation("LessonPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  archivedBy  User?          @relation("LessonArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  revisionOf  Lesson?        @relation("LessonRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions   Lesson[]       @relation("LessonRevision")

  @@index([topicId, order])
  @@index([status, order])
}

model Question {
  id          String       @id @default(cuid())
  lessonId    String
  prompt      String
  explanation String
  order       Int
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options     QuestionOption[]
  attempts    QuizAttempt[]

  @@unique([lessonId, order])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  isCorrect  Boolean  @default(false)
  order      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  learnerId  String
  questionId String
  optionId   String
  isCorrect  Boolean
  createdAt  DateTime @default(now())
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model LessonCompletion {
  id          String   @id @default(cuid())
  learnerId   String
  lessonId    String
  completedOn DateTime
  score       Int
  createdAt   DateTime @default(now())
  learner     Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId])
}

model Circle {
  id          String             @id @default(cuid())
  name        String
  createdAt   DateTime           @default(now())
  memberships CircleMembership[]
  invites     CircleInvite[]
}

model CircleMembership {
  id        String   @id @default(cuid())
  circleId  String
  learnerId String
  joinedAt  DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([circleId, learnerId])
}

model CircleInvite {
  id        String   @id @default(cuid())
  circleId  String
  creatorId String
  token     String   @unique
  expiresAt DateTime
  maxUses   Int      @default(3)
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  creator   Learner  @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
}

model MessageDelivery {
  id          String         @id @default(cuid())
  learnerId   String
  channel     Channel
  messageType String
  dueAt       DateTime
  status      DeliveryStatus @default(PENDING)
  providerId  String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  learner     Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, channel, messageType, dueAt])
}
